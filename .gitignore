# ============================================
# .gitignore - Sistema Criador de Horário
# © 2025 Wander Pires Silva Coelho
# PROTEÇÃO DE DADOS SENSÍVEIS
# ============================================

# ============================================
# CRÍTICO - DADOS SENSÍVEIS (NUNCA COMMIT)
# ============================================

# Variáveis de Ambiente com Tokens e Senhas
.env
.env.local
.env.development
.env.development.local
.env.test.local
.env.production.local
.env.backup
.env.*

# Credenciais e Certificados
*.pem
*.key
*.cert
*.crt
secrets/
credentials/

# Backups de Banco de Dados
*.sql
*.dump
*.backup
backups/
backend/backups/

# ============================================
# DEPENDÊNCIAS
# ============================================
node_modules/
.pnp
.pnp.js
bower_components/
jspm_packages/

# ============================================
# BUILD E DEPLOY
# ============================================
# Frontend build
frontend/dist/
frontend/build/
dist/
build/

# Backend compiled
backend/dist/*.js
backend/dist/**/*.js

# ============================================
# TESTES
# ============================================
coverage/
.nyc_output/
*.lcov

# ============================================
# LOGS E TEMPORÁRIOS
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Temporary files
*.tmp
*.temp
temp/
tmp/
.cache/

# ============================================
# SISTEMA OPERACIONAL
# ============================================
# MacOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini

# Linux
*~
.directory
.Trash-*

# ============================================
# IDEs E EDITORES
# ============================================
.vscode/
.idea/
*.swp
*.swo
*.swn
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ============================================
# BANCO DE DADOS LOCAL
# ============================================
*.sqlite
*.sqlite3
*.db
data/
mongodb-data/

# ============================================
# OUTROS
# ============================================
# Yarn
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# NPM
package-lock.json.backup

# PM2
.pm2/

# Webpack
.webpack/

# ESLint
.eslintcache

# ============================================
# ARQUIVOS DE DESENVOLVIMENTO/TESTE
# ============================================
test-*.js
debug-*.js
inspect-*.js
quick-*.js

# Backups
backups/

# IMPORTANTE: backend/dist/ NÃO está aqui!
# O Render precisa do código compilado
